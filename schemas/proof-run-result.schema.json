{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "confirmation_status",
    "disposition",
    "error",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "confirmation_status": {"enum": ["NOT_CONFIRMED", "CONFIRMED"]},
    "disposition": {"enum": ["confirmed", "not_confirmed", "failed"]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[\\s\\S]+$"
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "enum": ["certificate", "markdown", "poc", "events", "qubo"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\.?\\.?$)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)(?!.*\\\\)(?!.*//)(?!.*\\/$)[\\s\\S]+$"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "confirmation_status": {"const": "CONFIRMED"},
        "disposition": {"const": "confirmed"},
        "error": {"type": "null"},
        "artifacts": {
          "required": ["certificate", "markdown", "poc", "events"]
        }
      }
    },
    {
      "properties": {
        "confirmation_status": {"const": "NOT_CONFIRMED"},
        "disposition": {"const": "not_confirmed"},
        "error": {"type": "null"},
        "artifacts": {
          "propertyNames": {"enum": ["events", "qubo"]}
        }
      }
    },
    {
      "properties": {
        "confirmation_status": {"const": "NOT_CONFIRMED"},
        "disposition": {"const": "failed"},
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[\\s\\S]+$"
        },
        "artifacts": {"maxProperties": 0}
      }
    }
  ]
}
