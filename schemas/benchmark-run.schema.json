{
  "$defs": {
    "BenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "BenchmarkArtifact",
      "type": "object"
    },
    "ConfirmationStatus": {
      "enum": [
        "NOT_CONFIRMED",
        "CANDIDATE_VIOLATION",
        "CONFIRMED"
      ],
      "title": "ConfirmationStatus",
      "type": "string"
    },
    "NotApplicableStrategyEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "not_applicable",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NotApplicableStrategyEvidence",
      "type": "object"
    },
    "QuboStrategyEvidence": {
      "additionalProperties": false,
      "properties": {
        "builds": {
          "minimum": 0,
          "title": "Builds",
          "type": "integer"
        },
        "evidence_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "fallback_calls": {
          "minimum": 0,
          "title": "Fallback Calls",
          "type": "integer"
        },
        "fallback_seconds": {
          "minimum": 0,
          "title": "Fallback Seconds",
          "type": "number"
        },
        "kind": {
          "const": "qubo",
          "title": "Kind",
          "type": "string"
        },
        "max_couplers": {
          "minimum": 0,
          "title": "Max Couplers",
          "type": "integer"
        },
        "max_logical_bits": {
          "minimum": 0,
          "title": "Max Logical Bits",
          "type": "integer"
        },
        "reads": {
          "minimum": 0,
          "title": "Reads",
          "type": "integer"
        },
        "solver_calls": {
          "minimum": 0,
          "title": "Solver Calls",
          "type": "integer"
        },
        "solver_seconds": {
          "minimum": 0,
          "title": "Solver Seconds",
          "type": "number"
        },
        "sweeps": {
          "minimum": 0,
          "title": "Sweeps",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "evidence_sha256",
        "builds",
        "solver_calls",
        "reads",
        "sweeps",
        "solver_seconds",
        "fallback_calls",
        "fallback_seconds",
        "max_logical_bits",
        "max_couplers"
      ],
      "title": "QuboStrategyEvidence",
      "type": "object"
    },
    "QuboUnavailableEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "qubo_unavailable",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "QuboUnavailableEvidence",
      "type": "object"
    },
    "SearchLimits": {
      "additionalProperties": false,
      "properties": {
        "candidate_budget": {
          "exclusiveMinimum": 0,
          "title": "Candidate Budget",
          "type": "integer"
        },
        "max_sequence_length": {
          "exclusiveMinimum": 0,
          "title": "Max Sequence Length",
          "type": "integer"
        },
        "max_variants": {
          "default": 64,
          "exclusiveMinimum": 0,
          "title": "Max Variants",
          "type": "integer"
        },
        "transaction_budget": {
          "exclusiveMinimum": 0,
          "title": "Transaction Budget",
          "type": "integer"
        },
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_sequence_length",
        "transaction_budget",
        "candidate_budget",
        "wall_seconds"
      ],
      "title": "SearchLimits",
      "type": "object"
    },
    "TimingEvidence": {
      "additionalProperties": false,
      "properties": {
        "proof_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof Seconds"
        },
        "search_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Seconds"
        },
        "setup_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Seconds"
        },
        "strategy_initialization_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy Initialization Seconds"
        },
        "total_seconds": {
          "minimum": 0,
          "title": "Total Seconds",
          "type": "number"
        }
      },
      "required": [
        "total_seconds"
      ],
      "title": "TimingEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "candidates_evaluated": {
            "minimum": 0,
            "type": "integer"
          },
          "confirmation_status": {
            "enum": [
              "NOT_CONFIRMED",
              "CONFIRMED"
            ]
          },
          "error": {
            "type": "null"
          },
          "executed_violation": {
            "type": "boolean"
          },
          "hit_observation": {
            "enum": [
              "observed",
              "censored"
            ]
          },
          "proof_attempted": {
            "type": "boolean"
          },
          "search_hit": {
            "type": "boolean"
          },
          "search_transactions": {
            "minimum": 0,
            "type": "integer"
          },
          "stop_reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "stop_reason",
          "executed_violation",
          "search_hit",
          "proof_attempted",
          "hit_observation",
          "candidates_evaluated",
          "search_transactions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "confirmation_status": {
            "const": "NOT_CONFIRMED"
          },
          "error": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "incomplete"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "certificate_sha256": {
            "type": "null"
          },
          "cold_replays": {
            "type": "null"
          },
          "confirmation_status": {
            "const": "NOT_CONFIRMED"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "strategy_evidence": {
            "properties": {
              "kind": {
                "const": "not_applicable"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "if": {
        "properties": {
          "strategy": {
            "const": "qubo"
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "properties": {
          "strategy_evidence": {
            "properties": {
              "kind": {
                "enum": [
                  "qubo",
                  "qubo_unavailable"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confirmation_status": {
            "const": "CONFIRMED"
          }
        },
        "required": [
          "confirmation_status"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "required": [
              "result",
              "certificate",
              "poc",
              "events"
            ],
            "type": "object"
          },
          "certificate_sha256": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "cold_replays": {
            "const": 3
          },
          "executed_violation": {
            "const": true
          },
          "hit_observation": {
            "const": "observed"
          },
          "proof_attempted": {
            "const": true
          },
          "search_hit": {
            "const": true
          },
          "state": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "search_hit": {
            "const": true
          }
        },
        "required": [
          "search_hit"
        ]
      },
      "then": {
        "properties": {
          "first_hit_candidate": {
            "minimum": 1,
            "type": "integer"
          },
          "first_hit_transactions": {
            "minimum": 1,
            "type": "integer"
          },
          "hit_observation": {
            "const": "observed"
          },
          "proof_attempted": {
            "const": true
          }
        },
        "required": [
          "first_hit_candidate",
          "first_hit_transactions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "search_hit": {
            "const": false
          }
        },
        "required": [
          "search_hit"
        ]
      },
      "then": {
        "properties": {
          "first_hit_candidate": {
            "type": "null"
          },
          "first_hit_transactions": {
            "type": "null"
          },
          "hit_observation": {
            "const": "censored"
          },
          "proof_attempted": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "certificate_sha256": {
            "type": "null"
          },
          "cold_replays": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          {
            "properties": {
              "confirmation_status": {
                "const": "NOT_CONFIRMED"
              }
            },
            "required": [
              "confirmation_status"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "certificate_sha256": {
            "type": "null"
          },
          "cold_replays": {
            "type": "null"
          },
          "hit_observation": {
            "const": "censored"
          },
          "proof_attempted": {
            "const": false
          },
          "search_hit": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          {
            "properties": {
              "strategy": {
                "const": "qubo"
              }
            },
            "required": [
              "strategy"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "strategy_evidence": {
            "properties": {
              "kind": {
                "const": "qubo"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    }
  ],
  "description": "One immutable label-free raw benchmark row.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/BenchmarkArtifact"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "build_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Build Sha256",
      "type": "string"
    },
    "candidates_evaluated": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates Evaluated"
    },
    "certificate_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Certificate Sha256"
    },
    "cold_replays": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cold Replays"
    },
    "confirmation_status": {
      "$ref": "#/$defs/ConfirmationStatus"
    },
    "duplicate_proposals": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Proposals"
    },
    "effective_limits": {
      "$ref": "#/$defs/SearchLimits"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "executed_violation": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executed Violation"
    },
    "first_hit_candidate": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Hit Candidate"
    },
    "first_hit_transactions": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Hit Transactions"
    },
    "hit_observation": {
      "anyOf": [
        {
          "enum": [
            "observed",
            "censored"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hit Observation"
    },
    "lockfile_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Lockfile Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "matrix_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Matrix Id",
      "type": "string"
    },
    "minimized_steps": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimized Steps"
    },
    "outcome_counts": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Outcome Counts",
      "type": "object"
    },
    "problem_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Problem Sha256",
      "type": "string"
    },
    "proof_attempted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proof Attempted"
    },
    "public_target_id": {
      "minLength": 1,
      "title": "Public Target Id",
      "type": "string"
    },
    "qprover_source_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Qprover Source Sha256",
      "type": "string"
    },
    "row_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Row Sha256",
      "type": "string"
    },
    "run_key": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Key",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "search_hit": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Search Hit"
    },
    "search_transactions": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Search Transactions"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "source_closure_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Closure Sha256",
      "type": "string"
    },
    "state": {
      "enum": [
        "completed",
        "failed",
        "incomplete"
      ],
      "title": "State",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "strategy": {
      "enum": [
        "random",
        "coverage",
        "risk",
        "qubo"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "strategy_config_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Strategy Config Sha256",
      "type": "string"
    },
    "strategy_evidence": {
      "discriminator": {
        "mapping": {
          "not_applicable": "#/$defs/NotApplicableStrategyEvidence",
          "qubo": "#/$defs/QuboStrategyEvidence",
          "qubo_unavailable": "#/$defs/QuboUnavailableEvidence"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NotApplicableStrategyEvidence"
        },
        {
          "$ref": "#/$defs/QuboStrategyEvidence"
        },
        {
          "$ref": "#/$defs/QuboUnavailableEvidence"
        }
      ],
      "title": "Strategy Evidence"
    },
    "timings": {
      "$ref": "#/$defs/TimingEvidence"
    },
    "toolchain_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Toolchain Sha256",
      "type": "string"
    },
    "total_transactions": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Transactions"
    },
    "unique_trace_features": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unique Trace Features"
    }
  },
  "required": [
    "schema_version",
    "row_sha256",
    "run_key",
    "matrix_id",
    "public_target_id",
    "manifest_sha256",
    "source_closure_sha256",
    "build_sha256",
    "problem_sha256",
    "qprover_source_sha256",
    "lockfile_sha256",
    "toolchain_sha256",
    "strategy",
    "strategy_config_sha256",
    "seed",
    "effective_limits",
    "state",
    "confirmation_status",
    "strategy_evidence",
    "timings"
  ],
  "title": "BenchmarkRun",
  "type": "object"
}
