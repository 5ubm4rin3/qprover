{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qprover.local/schemas/certificate.schema.json",
  "title": "QProver Proof Certificate",
  "$comment": "Structural validation is necessary but not sufficient; qprover.replay.cold_verify semantic binding and local execution are mandatory before confirmation.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"confirmation_status": {"const": "CONFIRMED"}}, "required": ["confirmation_status"]},
      "then": {
        "properties": {
          "source_kind": {"const": "executed"},
          "final_evaluation_outcome": {"const": "VIOLATION"},
          "chain": {"properties": {"external_rpc": {"const": false}}},
          "invariant": {"properties": {"evaluated": {"const": true}, "value": {"const": false}}},
          "impact": {"properties": {"admissible": {"const": true}, "executed": {"const": true}}},
          "replay": {"properties": {"local_only": {"const": true}, "recipe": {"$ref": "#/$defs/replayRecipe"}, "records": {"minItems": 3, "maxItems": 3, "items": {"properties": {"success": {"const": true}, "exit_code": {"const": 0}, "staging_unchanged": {"const": true}, "suite_count": {"const": 1}, "test_count": {"const": 1}, "executed_suite": {"const": "test/QProverReplay.t.sol:QProverReplayTest"}, "executed_test": {"const": "test_qprover_replay()"}, "executed_status": {"const": "Success"}}}}}}
        }
      }
    }
  ],
  "required": ["schema_version", "run_id", "generated_at", "confirmation_status", "source_kind", "final_evaluation_outcome", "target", "artifacts", "build", "toolchain", "chain", "funding", "assumptions", "initial_state", "transactions", "before_after", "invariant", "impact", "gas", "minimization", "poc", "replay_invocation_template", "replay", "assurance", "certificate_identity_sha256", "certificate_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
