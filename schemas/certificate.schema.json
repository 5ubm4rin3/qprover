{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qprover.local/schemas/certificate.schema.json",
  "title": "QProver Proof Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "confirmation_status", "source_kind", "final_evaluation_outcome", "target", "artifacts", "build", "toolchain", "chain", "funding", "assumptions", "initial_state", "transactions", "before_after", "invariant", "impact", "gas", "minimization", "poc", "replay_command", "replay", "certificate_identity_sha256", "certificate_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "confirmation_status": {"enum": ["NOT_CONFIRMED", "CANDIDATE_VIOLATION", "CONFIRMED"]},
    "source_kind": {"enum": ["executed", "static_lead"]},
    "final_evaluation_outcome": {"$ref": "#/$defs/outcome"},
    "target": {"$ref": "#/$defs/target"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "build": {"$ref": "#/$defs/build"},
    "toolchain": {"$ref": "#/$defs/toolchain"},
    "chain": {"$ref": "#/$defs/chain"},
    "funding": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/funding"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assumption"}},
    "initial_state": {"$ref": "#/$defs/state"},
    "transactions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transaction"}},
    "before_after": {"type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": {"before": {"$ref": "#/$defs/state"}, "after": {"$ref": "#/$defs/state"}}},
    "invariant": {"$ref": "#/$defs/invariant"},
    "impact": {"$ref": "#/$defs/impact"},
    "gas": {"$ref": "#/$defs/gas"},
    "minimization": {"$ref": "#/$defs/minimization"},
    "poc": {"$ref": "#/$defs/poc"},
    "replay_command": {"type": "string", "minLength": 1},
    "replay": {"$ref": "#/$defs/replay"},
    "certificate_identity_sha256": {"$ref": "#/$defs/sha256"},
    "certificate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["PASS", "VIOLATION", "REVERT", "INCONCLUSIVE", "INFRA_ERROR"]},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["id", "workspace_root", "project_root", "revision", "manifest_path", "manifest_sha256", "source_sha256", "sources"], "properties": {"id": {"type": "string", "minLength": 1}, "workspace_root": {"type": "string", "minLength": 1}, "project_root": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "manifest_path": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["compilation_target", "artifact_path", "artifact_sha256", "bytecode_sha256", "build_info_id", "build_info_sha256"], "properties": {"compilation_target": {"type": "string", "minLength": 1}, "artifact_path": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "bytecode_sha256": {"$ref": "#/$defs/sha256"}, "build_info_id": {"type": "string", "minLength": 1}, "build_info_sha256": {"$ref": "#/$defs/sha256"}}},
    "build": {"type": "object", "additionalProperties": false, "required": ["command", "manifest_sha256", "source_sha256", "build_info_sha256"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "build_info_sha256": {"$ref": "#/$defs/sha256"}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["qprover_version", "forge_version", "compiler_version", "evm_version"], "properties": {"qprover_version": {"type": "string", "minLength": 1}, "forge_version": {"type": "string", "minLength": 1}, "compiler_version": {"type": "string", "minLength": 1}, "evm_version": {"type": "string", "minLength": 1}}},
    "chain": {"type": "object", "additionalProperties": false, "required": ["kind", "chain_id", "genesis_timestamp", "base_fee_wei", "gas_price_wei", "external_rpc"], "properties": {"kind": {"const": "local"}, "chain_id": {"type": "integer", "minimum": 1}, "genesis_timestamp": {"type": "integer", "minimum": 0}, "base_fee_wei": {"type": "integer", "minimum": 0}, "gas_price_wei": {"type": "integer", "minimum": 0}, "external_rpc": {"type": "boolean"}}},
    "funding": {"type": "object", "additionalProperties": false, "required": ["actor_id", "slot", "balance_wei"], "properties": {"actor_id": {"type": "string", "minLength": 1}, "slot": {"type": "integer", "minimum": 0}, "balance_wei": {"type": "integer", "minimum": 0}}},
    "assumption": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["values", "state_sha256"], "properties": {"values": {"type": "object", "additionalProperties": {"oneOf": [{"type": "integer"}, {"type": "boolean"}]}}, "state_sha256": {"$ref": "#/$defs/sha256"}}},
    "transaction": {"type": "object", "additionalProperties": false, "required": ["index", "action_id", "target_id", "signature", "sender_slot", "args", "value_wei", "calldata_sha256", "transaction_sha256", "expected_success", "receipt_status", "gas_used", "return_data", "revert_data", "trace_sha256", "observation_state_sha256"], "properties": {"index": {"type": "integer", "minimum": 1}, "action_id": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1}, "sender_slot": {"type": "integer", "minimum": 0}, "args": {"type": "array"}, "value_wei": {"type": "integer", "minimum": 0}, "calldata_sha256": {"$ref": "#/$defs/sha256"}, "transaction_sha256": {"$ref": "#/$defs/sha256"}, "expected_success": {"type": "boolean"}, "receipt_status": {"type": "integer", "minimum": 0, "maximum": 1}, "gas_used": {"type": "integer", "minimum": 0}, "return_data": {"type": ["string", "null"]}, "revert_data": {"type": ["string", "null"]}, "trace_sha256": {"$ref": "#/$defs/sha256"}, "observation_state_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
    "invariant": {"type": "object", "additionalProperties": false, "required": ["id", "expression", "description", "foundry_assertion", "evaluated", "value", "reason"], "properties": {"id": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "foundry_assertion": {"type": "string", "minLength": 1}, "evaluated": {"type": "boolean"}, "value": {"type": ["boolean", "null"]}, "reason": {"type": ["string", "null"]}}},
    "impact": {"type": "object", "additionalProperties": false, "required": ["attacker_observation", "protocol_observation", "attacker_delta", "protocol_delta", "unit", "admissible", "executed"], "properties": {"attacker_observation": {"type": "string", "minLength": 1}, "protocol_observation": {"type": "string", "minLength": 1}, "attacker_delta": {"type": "integer"}, "protocol_delta": {"type": "integer"}, "unit": {"type": "string", "minLength": 1}, "admissible": {"type": "boolean"}, "executed": {"type": "boolean"}}},
    "gas": {"type": "object", "additionalProperties": false, "required": ["total_gas_used", "per_transaction"], "properties": {"total_gas_used": {"type": "integer", "minimum": 0}, "per_transaction": {"type": "array", "items": {"type": "integer", "minimum": 0}}}},
    "minimization": {"type": "object", "additionalProperties": false, "required": ["original_steps", "minimized_steps", "evaluation_count", "uncached_candidate_count", "candidate_attempt_count", "unique_candidate_count", "cache_hits", "transaction_count", "attempted_operators", "locally_minimal", "minimality_claim", "final_outcome"], "properties": {"original_steps": {"type": "integer", "minimum": 1}, "minimized_steps": {"type": "integer", "minimum": 1}, "evaluation_count": {"type": "integer", "minimum": 1}, "uncached_candidate_count": {"type": "integer", "minimum": 1}, "candidate_attempt_count": {"type": "integer", "minimum": 1}, "unique_candidate_count": {"type": "integer", "minimum": 1}, "cache_hits": {"type": "integer", "minimum": 0}, "transaction_count": {"type": "integer", "minimum": 0}, "attempted_operators": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "locally_minimal": {"type": "boolean"}, "minimality_claim": {"type": "string", "minLength": 1}, "final_outcome": {"$ref": "#/$defs/outcome"}}},
    "poc": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "manifest_sha256", "source_sha256", "artifact_sha256", "test_name"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "test_name": {"const": "test_qprover_replay"}}},
    "replayRecord": {"type": "object", "additionalProperties": false, "required": ["index", "success", "command", "exit_code", "stdout_sha256", "stderr_sha256", "duration_seconds", "certificate_identity_sha256", "poc_sha256", "manifest_sha256", "source_sha256", "artifact_sha256"], "properties": {"index": {"type": "integer", "minimum": 1}, "success": {"type": "boolean"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exit_code": {"type": "integer"}, "stdout_sha256": {"$ref": "#/$defs/sha256"}, "stderr_sha256": {"$ref": "#/$defs/sha256"}, "duration_seconds": {"type": "number", "minimum": 0}, "certificate_identity_sha256": {"$ref": "#/$defs/sha256"}, "poc_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "replay": {"type": "object", "additionalProperties": false, "required": ["local_only", "required_repeats", "records"], "properties": {"local_only": {"type": "boolean"}, "required_repeats": {"const": 3}, "records": {"type": "array", "items": {"$ref": "#/$defs/replayRecord"}}}}
  }
}
