    "before_after": {"type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": {"before": {"$ref": "#/$defs/state"}, "after": {"$ref": "#/$defs/state"}}},
    "invariant": {"$ref": "#/$defs/invariant"},
    "impact": {"$ref": "#/$defs/impact"},
    "gas": {"$ref": "#/$defs/gas"},
    "minimization": {"$ref": "#/$defs/minimization"},
    "poc": {"$ref": "#/$defs/poc"},
    "replay_invocation_template": {"const": "qprover replay --workspace {workspace} {certificate}"},
    "replay": {"$ref": "#/$defs/replay"},
    "assurance": {"$ref": "#/$defs/assurance"},
    "certificate_identity_sha256": {"$ref": "#/$defs/sha256"},
    "certificate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["PASS", "VIOLATION", "REVERT", "INCONCLUSIVE", "INFRA_ERROR"]},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["id", "workspace_root", "project_root", "revision", "revision_proven", "manifest_path", "manifest_sha256", "source_sha256", "sources"], "properties": {"id": {"type": "string", "minLength": 1}, "workspace_root": {"const": "."}, "project_root": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"}, "revision": {"type": "string", "minLength": 1}, "revision_proven": {"const": false}, "manifest_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["compilation_target", "artifact_path", "artifact_sha256", "bytecode_sha256", "build_info_id", "build_info_sha256", "constructor_types"], "properties": {"compilation_target": {"type": "string", "minLength": 1}, "artifact_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "bytecode_sha256": {"$ref": "#/$defs/sha256"}, "build_info_id": {"type": "string", "minLength": 1}, "build_info_sha256": {"$ref": "#/$defs/sha256"}, "constructor_types": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "build": {"type": "object", "additionalProperties": false, "required": ["command", "manifest_sha256", "source_sha256", "build_info_sha256"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "build_info_sha256": {"$ref": "#/$defs/sha256"}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["qprover_version", "forge_version", "compiler_version", "evm_version"], "properties": {"qprover_version": {"type": "string", "minLength": 1}, "forge_version": {"type": "string", "minLength": 1}, "compiler_version": {"type": "string", "minLength": 1}, "evm_version": {"type": "string", "minLength": 1}}},
    "chain": {"type": "object", "additionalProperties": false, "required": ["kind", "chain_id", "genesis_timestamp", "base_fee_wei", "gas_price_wei", "external_rpc"], "properties": {"kind": {"const": "local"}, "chain_id": {"type": "integer", "minimum": 1}, "genesis_timestamp": {"type": "integer", "minimum": 0}, "base_fee_wei": {"type": "integer", "minimum": 0}, "gas_price_wei": {"type": "integer", "minimum": 0}, "external_rpc": {"type": "boolean"}}},
    "funding": {"type": "object", "additionalProperties": false, "required": ["actor_id", "slot", "address", "balance_wei"], "properties": {"actor_id": {"type": "string", "minLength": 1}, "slot": {"type": "integer", "minimum": 0}, "address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"}, "balance_wei": {"type": "integer", "minimum": 0}}},
    "assumption": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["values", "state_sha256"], "properties": {"values": {"type": "object", "additionalProperties": {"oneOf": [{"type": "integer"}, {"type": "boolean"}]}}, "state_sha256": {"$ref": "#/$defs/sha256"}}},
    "transaction": {"type": "object", "additionalProperties": false, "required": ["index", "action_id", "target_id", "signature", "sender_slot", "args", "value_wei", "calldata_sha256", "transaction_sha256", "expected_success", "receipt_status", "gas_used", "return_data", "revert_data", "trace_sha256", "observation_state_sha256"], "properties": {"index": {"type": "integer", "minimum": 1}, "action_id": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1}, "sender_slot": {"type": "integer", "minimum": 0}, "args": {"type": "array"}, "value_wei": {"type": "integer", "minimum": 0}, "calldata_sha256": {"$ref": "#/$defs/sha256"}, "transaction_sha256": {"$ref": "#/$defs/sha256"}, "expected_success": {"type": "boolean"}, "receipt_status": {"type": "integer", "minimum": 0, "maximum": 1}, "gas_used": {"type": "integer", "minimum": 0}, "return_data": {"type": ["string", "null"]}, "revert_data": {"type": ["string", "null"]}, "trace_sha256": {"$ref": "#/$defs/sha256"}, "observation_state_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
    "invariant": {"type": "object", "additionalProperties": false, "required": ["id", "expression", "description", "foundry_assertion", "evaluated", "value", "reason"], "properties": {"id": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "foundry_assertion": {"type": "string", "minLength": 1}, "evaluated": {"type": "boolean"}, "value": {"type": ["boolean", "null"]}, "reason": {"type": ["string", "null"]}}},
    "impact": {"type": "object", "additionalProperties": false, "required": ["attacker_observation", "protocol_observation", "attacker_delta", "protocol_delta", "unit", "admissible", "executed"], "properties": {"attacker_observation": {"type": "string", "minLength": 1}, "protocol_observation": {"type": "string", "minLength": 1}, "attacker_delta": {"type": "integer"}, "protocol_delta": {"type": "integer"}, "unit": {"type": "string", "minLength": 1}, "admissible": {"type": "boolean"}, "executed": {"type": "boolean"}}},
    "gas": {"type": "object", "additionalProperties": false, "required": ["total_gas_used", "per_transaction"], "properties": {"total_gas_used": {"type": "integer", "minimum": 0}, "per_transaction": {"type": "array", "items": {"type": "integer", "minimum": 0}}}},
    "minimization": {"type": "object", "additionalProperties": false, "required": ["original_steps", "minimized_steps", "evaluation_count", "uncached_candidate_count", "candidate_attempt_count", "unique_candidate_count", "cache_hits", "transaction_count", "attempted_operators", "locally_minimal", "minimality_claim", "final_outcome"], "properties": {"original_steps": {"type": "integer", "minimum": 1}, "minimized_steps": {"type": "integer", "minimum": 1}, "evaluation_count": {"type": "integer", "minimum": 1}, "uncached_candidate_count": {"type": "integer", "minimum": 1}, "candidate_attempt_count": {"type": "integer", "minimum": 1}, "unique_candidate_count": {"type": "integer", "minimum": 1}, "cache_hits": {"type": "integer", "minimum": 0}, "transaction_count": {"type": "integer", "minimum": 0}, "attempted_operators": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "locally_minimal": {"type": "boolean"}, "minimality_claim": {"const": "Replay-verified local minimum under one-step deletion only."}, "final_outcome": {"$ref": "#/$defs/outcome"}}},
    "poc": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "manifest_sha256", "source_sha256", "artifact_sha256", "test_name"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"}, "sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "test_name": {"const": "test_qprover_replay"}}},
    "replayRecipe": {"type": "object", "additionalProperties": false, "required": ["workspace_cwd", "source_project", "source_poc", "foundry_config", "foundry_config_sha256", "source_sha256", "poc_sha256", "staged_project", "execution_cwd", "staged_poc", "materialization", "argv_template", "staging_tree_sha256"], "properties": {"workspace_cwd": {"const": "."}, "source_project": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"}, "source_poc": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"}, "foundry_config": {"const": "foundry.toml"}, "foundry_config_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "poc_sha256": {"$ref": "#/$defs/sha256"}, "staged_project": {"const": "{private_project}"}, "execution_cwd": {"const": "{private_project}"}, "staged_poc": {"const": "test/QProverReplay.t.sol"}, "materialization": {"const": "copy hash-verified foundry.toml and certificate source closure into {private_project}; write and hash-check the certificate PoC only at test/QProverReplay.t.sol; make staged inputs read-only; revalidate the complete staged tree immediately before and after Forge"}, "argv_template": {"type": "array", "minItems": 14, "maxItems": 14, "prefixItems": [{"const": "forge"}, {"const": "test"}, {"const": "--offline"}, {"const": "--root"}, {"const": "{private_project}"}, {"const": "--match-path"}, {"const": "test/QProverReplay.t.sol"}, {"const": "--match-test"}, {"const": "test_qprover_replay"}, {"const": "--json"}, {"const": "--out"}, {"const": "{private_out}"}, {"const": "--cache-path"}, {"const": "{private_cache}"}], "items": false}, "staging_tree_sha256": {"$ref": "#/$defs/sha256"}}},
    "replayRecord": {"type": "object", "additionalProperties": false, "required": ["index", "success", "exit_code", "stdout_sha256", "stderr_sha256", "structured_result_sha256", "duration_seconds", "recipe_sha256", "execution_argv_sha256", "execution_cwd_sha256", "staging_tree_sha256", "staging_unchanged", "suite_count", "test_count", "executed_suite", "executed_test", "executed_status", "certificate_identity_sha256", "poc_sha256", "manifest_sha256", "source_sha256", "artifact_sha256"], "properties": {"index": {"type": "integer", "minimum": 1}, "success": {"type": "boolean"}, "exit_code": {"type": "integer"}, "stdout_sha256": {"$ref": "#/$defs/sha256"}, "stderr_sha256": {"$ref": "#/$defs/sha256"}, "structured_result_sha256": {"$ref": "#/$defs/sha256"}, "duration_seconds": {"type": "number", "minimum": 0}, "recipe_sha256": {"$ref": "#/$defs/sha256"}, "execution_argv_sha256": {"$ref": "#/$defs/sha256"}, "execution_cwd_sha256": {"$ref": "#/$defs/sha256"}, "staging_tree_sha256": {"$ref": "#/$defs/sha256"}, "staging_unchanged": {"type": "boolean"}, "suite_count": {"type": "integer", "minimum": 0}, "test_count": {"type": "integer", "minimum": 0}, "executed_suite": {"type": ["string", "null"]}, "executed_test": {"type": ["string", "null"]}, "executed_status": {"type": ["string", "null"]}, "certificate_identity_sha256": {"$ref": "#/$defs/sha256"}, "poc_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "replay": {"type": "object", "additionalProperties": false, "required": ["local_only", "required_repeats", "recipe", "records"], "properties": {"local_only": {"type": "boolean"}, "required_repeats": {"const": 3}, "recipe": {"oneOf": [{"$ref": "#/$defs/replayRecipe"}, {"type": "null"}]}, "records": {"type": "array", "items": {"$ref": "#/$defs/replayRecord"}}}, "allOf": [{"if": {"properties": {"records": {"minItems": 1}}, "required": ["records"]}, "then": {"properties": {"recipe": {"$ref": "#/$defs/replayRecipe"}}}, "else": {"properties": {"recipe": {"type": "null"}}}}]},
    "assurance": {"type": "object", "additionalProperties": false, "required": ["replay_proven_scope", "historical_search_metadata_scope", "invocation_template_scope", "trusted_local_execution_boundary", "cryptographic_attestation"], "properties": {"replay_proven_scope": {"const": "manifest/source/build/artifact identities; local chain and actor funding; transaction execution, receipts, gas, traces, intermediate and final observations; invariant and impact; single-delete local minimality; three private staged offline Foundry executions of exactly one named passing test with stable structured results"}, "historical_search_metadata_scope": {"const": "revision label; assumptions; run identifier and timestamp; search and minimization counters and attempted-operator history"}, "invocation_template_scope": {"const": "replay_invocation_template contains unresolved placeholders and is not executable until resolved by a conforming QProver CLI"}, "trusted_local_execution_boundary": {"const": "Forge, Solc, and Anvil executables are trusted local tool boundaries; the privileged local host is trusted; no cryptographic attestation protects against a compromised executable or privileged host"}, "cryptographic_attestation": {"const": false}}}
  }
}
